<div class="box tabular settings">
  <h3><%= l(:label_testcase_settings) %></h3>

  <p>
    <label><%= l(:label_testcase_trackers) %></label>
    <%= hidden_field_tag 'settings[testcase_tracker_ids][]', '' %>
    <span class="testcase-trackers">
      <% Tracker.sorted.each do |tracker| %>
        <label class="block">
          <%= check_box_tag 'settings[testcase_tracker_ids][]', tracker.id,
                            RedmineTestcase.tracker_ids.include?(tracker.id.to_s),
                            id: nil %>
          <%= tracker.name %>
        </label>
      <% end %>
    </span>
  </p>

  <p class="form-hint">
    <%= l(:text_select_testcase_trackers) %>
  </p>

  <% missing = RedmineTestcase.projects_without_module.to_a %>
  <% if RedmineTestcase.tracker_configured? && missing.any? %>
    <div class="flash warning testcase-module-warning">
      <%= l(:text_testcase_module_disabled_projects) %>
      <ul>
        <% missing.first(20).each do |project| %>
          <li><%= link_to project.name, settings_project_path(project, tab: 'modules') %></li>
        <% end %>
      </ul>
      <% if missing.size > 20 %>
        <%= l(:text_testcase_module_more_projects, count: missing.size - 20) %>
      <% end %>
    </div>
  <% end %>

  <p>
    <label for="settings_log_changes_to_issue"><%= l(:setting_log_changes_to_issue) %></label>
    <%= hidden_field_tag 'settings[log_changes_to_issue]', '0' %>
    <%= check_box_tag 'settings[log_changes_to_issue]', '1',
                      Setting.plugin_redmine_testcase['log_changes_to_issue'].to_s == '1',
                      id: 'settings_log_changes_to_issue' %>
  </p>

  <p class="form-hint">
    <%= l(:text_log_changes_to_issue_hint) %>
  </p>
</div>
