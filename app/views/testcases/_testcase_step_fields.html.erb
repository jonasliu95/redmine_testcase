<tr class="testcase-step-row" data-persisted="<%= f.object.persisted? %>">
  <td class="step-number"></td>
  <td>
    <%= f.text_area :action, rows: 2, class: 'wiki-edit', maxlength: 10000 %>
    <% if local_assigns[:toolbar] %>
      <%= wikitoolbar_for f.field_id(:action) %>
    <% end %>
  </td>
  <td><%= f.text_area :test_data, rows: 2, class: 'wiki-edit', maxlength: 10000 %>
    <% if local_assigns[:toolbar] %><%= wikitoolbar_for f.field_id(:test_data) %><% end %>
  </td>
  <td><%= f.text_area :expected_result, rows: 2, class: 'wiki-edit', maxlength: 10000 %>
    <% if local_assigns[:toolbar] %><%= wikitoolbar_for f.field_id(:expected_result) %><% end %>
  </td>
  <td><%= f.text_area :actual_result, rows: 2, class: 'wiki-edit', maxlength: 10000 %>
    <% if local_assigns[:toolbar] %><%= wikitoolbar_for f.field_id(:actual_result) %><% end %>
  </td>
  <td>
    <%= f.select :status, Testcase.status_options,
                 {selected: f.object.status.presence || 'not_executed'} %>
  </td>
  <td class="step-actions">
    <%= f.hidden_field :id if f.object.persisted? %>
    <%= f.hidden_field :_destroy, value: '0', class: 'testcase-step-destroy' %>
    <%= link_to l(:button_remove_step), '#', class: 'remove-testcase-step icon icon-del' %>
  </td>
</tr>
